# calculate monthly figures per county
IRL_covid_per_month <- IRL_counties_Covid19_df %>%
group_by(month, year, CountyName) %>%
summarise(total_cases_per_month = sum(DailyCCase))
# We need to normalise by population of each county.
# Get the population per county from the original data frame
county_pop <- IRL_counties_Covid19_df %>%
filter(TimeStamp == "2021-03-01") %>% select(CountyName, Population)
# add population figure for each county using a left outer join
IRL_covid_per_month <-
merge(x = IRL_covid_per_month,
y = county_pop,
by = "CountyName",
all.x = TRUE)
head(IRL_covid_per_month)
# calculate total number cases per county normalized by 100,000 of population
IRL_covid_per_month <- IRL_covid_per_month %>%
mutate(total_cases_per_month_per_100k =  round((
100000  * total_cases_per_month / Population
), 0))
head(IRL_covid_per_month)
IRL_counties_Covid19_df <- read.csv("IRL_counties_Covid19_df.csv")
# Some counties have NA recorded for February 2020, when there were no covid cases in many places
# Here I change these NA values to zero (cases).
IRL_counties_Covid19_df$DailyCCase[is.na(IRL_counties_Covid19_df$DailyCCase)] <-0
# extract year value from TimeStamp
IRL_counties_Covid19_df$year <-
year(ymd(IRL_counties_Covid19_df$TimeStamp))
# extract month value from TimeStamp
IRL_counties_Covid19_df$month <-
month(ymd(IRL_counties_Covid19_df$TimeStamp))
head(IRL_counties_Covid19_df)
# calculate monthly figures per county
IRL_covid_per_month <- IRL_counties_Covid19_df %>%
group_by(month, year, CountyName) %>%
summarise(total_cases_per_month = sum(DailyCCase))
# We need to normalise by population of each county.
# Get the population per county from the original data frame
county_pop <- IRL_counties_Covid19_df %>%
filter(TimeStamp == "2021-03-01") %>% select(CountyName, Population)
# add population figure for each county using a left outer join
IRL_covid_per_month <-
merge(x = IRL_covid_per_month,
y = county_pop,
by = "CountyName",
all.x = TRUE)
head(IRL_covid_per_month)
# calculate total number cases per county normalized by 100,000 of population
IRL_covid_per_month <- IRL_covid_per_month %>%
mutate(total_cases_per_month_per_100k =  round((
100000  * total_cases_per_month / Population
), 0))
head(IRL_covid_per_month)
IRL_covid_per_month <- IRL_covid_per_month %>%
group_by(month, year) %>%
mutate(
mean_cases = mean(total_cases_per_month_per_100k, na.rm = T),
deviation = total_cases_per_month_per_100k - mean_cases
) %>%
ungroup()
head(IRL_covid_per_month)
ggplot(IRL_covid_per_month, aes(x = month, y = CountyName, fill = deviation)) +
geom_tile(color = "white") +
scale_fill_gradient2(
low = "blue",
mid = "white",
high = "red",
midpoint = 0,
name = "Deviation"
) +
labs(
title = "Monthly COVID-19 Cases Deviation from Mean (per 100,000)",
x = "Month",
y = "County"
) +
theme_minimal() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
panel.grid = element_blank()
)
# Create a date object to represent each month - year combination
# As a date object has to have a day value I have chosen the 1st of the month
# Using a Date format will keep the dates in order on the x-axis
IRL_covid_per_month <- IRL_covid_per_month %>%
mutate(date = as.Date(paste0(year, "-", month, "-01", sep = "")))
# select the subset of columns  needed to plot the heatmap
Plot_data_IRL_covid_per_month <- IRL_covid_per_month[, c(7, 1, 6)]
# calculate monthly figures per county
ave_cases <- Plot_data_IRL_covid_per_month %>%
group_by(CountyName) %>%
summarise(average_cases_per_month_per_100k = mean(total_cases_per_month_per_100k))
# reorder the CountyName levels using the average_cases_per_month_per_100k
ave_cases$CountyName <-
reorder(ave_cases$CountyName,
ave_cases$average_cases_per_month_per_100k)
# reset the levels of the CountyName variable in the data we are going to plot
# Resetting the CountyName levels  will result in the counties being displayed in descending order of average case incidence per 100,000
Plot_data_IRL_covid_per_month$CountyName <-
factor(Plot_data_IRL_covid_per_month$CountyName,
levels = levels(ave_cases$CountyName))
# Create a date object to represent each month - year combination
# As a date object has to have a day value I have chosen the 1st of the month
# Using a Date format will keep the dates in order on the x-axis
IRL_covid_per_month <- IRL_covid_per_month %>%
mutate(date = as.Date(paste0(year, "-", month, "-01", sep = "")))
# select the subset of columns  needed to plot the heatmap
Plot_data_IRL_covid_per_month <- IRL_covid_per_month[, c(7, 1, 6)]
# calculate monthly figures per county
ave_cases <- Plot_data_IRL_covid_per_month %>%
group_by(CountyName) %>%
summarise(average_cases_per_month_per_100k = mean(total_cases_per_month_per_100k))
# reorder the CountyName levels using the average_cases_per_month_per_100k
ave_cases$CountyName <-
reorder(ave_cases$CountyName,
ave_cases$average_cases_per_month_per_100k)
# reset the levels of the CountyName variable in the data we are going to plot
# Resetting the CountyName levels  will result in the counties being displayed in descending order of average case incidence per 100,000
Plot_data_IRL_covid_per_month$CountyName <-
factor(Plot_data_IRL_covid_per_month$CountyName,
levels = levels(ave_cases$CountyName))
heat <-
ggplot(
Plot_data_IRL_covid_per_month,
aes(x = as.factor(date), y = CountyName, fill = deviation)
) +
geom_tile(colour = "white", linewidth = 0.2) +
scale_x_discrete(
breaks = c(
"2020-01-01",
"2020-04-01" ,
"2020-07-01",
"2020-10-01",
"2021-01-01",
"2021-04-01" ,
"2021-07-01",
"2021-10-01",
"2022-01-01"
),
labels = c(
"Jan-20",
"Apr-20",
"Jul-20" ,
"Oct-20",
" Jan-21",
"Apr-21",
"Jul-21" ,
"Oct-21",
"Jan-22"
),
expand = c(0, 0)
) +
scale_fill_viridis_c(
option = "B",
begin = 0.1,
end = 0.9,
direction = -1,
name = "Covid-19 incidence per 100,000",
guide = guide_colourbar(
direction = "horizontal",
barwidth = 8,
barheight = 0.8
)
) +
labs(title = "Monthly Covid Figures per County per 100,000 people", y =
"Cases per 100,000 Population") +
coord_cartesian(clip = 'off') +
theme(
axis.title.x = element_blank(),
axis.text.y = element_text(size = 9),
axis.ticks.x = element_line(linewidth = 0.3, colour = "darkgrey"),
axis.line.x = element_line(linewidth = 0.1, colour = "darkgrey"),
axis.ticks.y = element_blank(),
axis.line.y = element_blank(),
panel.background = element_blank(),
panel.grid.major = element_blank(),
plot.margin = unit(c(
t = 0.0,
r = 0.0,
b = 0.5,
l = 0.5
), "cm"),
plot.title = element_text(size = 12, face = "bold")
) +
theme(
legend.text = element_text(size = 8),
legend.position = "top",
# move to the bottom
legend.justification = "left",
legend.title = element_blank(),
legend.key.size = unit(0.9, "line"),
legend.spacing.x = unit(0.2, 'cm'),
legend.background = element_rect(
fill = "white",
linewidth = 0.5,
colour = "white"
)
)
heat
